@@ -39,7 +39,7 @@ public class ClientboundLevelChunkPacketData {
         ClientboundLevelChunkPacketData::new
     );
     private final Map<Heightmap.Types, long[]> heightmaps;
-    private final byte[] buffer;
+    private byte[] buffer; // Papyrus - Compact Anti-Xray packet palettes
     private final List<ClientboundLevelChunkPacketData.BlockEntityInfo> blockEntitiesData;
     // Paper start - Handle oversized block entities in chunks
     private final java.util.List<net.minecraft.network.protocol.Packet<?>> extraPackets = new java.util.ArrayList<>();
@@ -51,12 +51,29 @@ public class ClientboundLevelChunkPacketData {
     // Paper end - Handle oversized block entities in chunks
     // Paper start - Async-Anti-Xray - Ready flag for the connection
     private volatile boolean ready = true;
+    private int antiXrayPaletteSections; // Papyrus - Compact Anti-Xray packet palettes
+
+    void configureAntiXrayPaletteCompaction(final int sectionCount) {
+        this.antiXrayPaletteSections = sectionCount;
+    }
+
+    void compactAntiXrayPalettes(final int sectionCount) {
+        this.buffer = ChunkPacketPaletteRewriter.compact(
+            this.buffer, sectionCount, net.minecraft.util.Mth.ceillog2(net.minecraft.world.level.block.Block.BLOCK_STATE_REGISTRY.size())
+        );
+    }
 
     public boolean isReady() {
         return this.ready;
     }
 
     public void setReady(final boolean ready) {
+        // Papyrus start - Compact Anti-Xray packet palettes
+        if (ready && !this.ready && this.antiXrayPaletteSections != 0) {
+            // Publish the compacted buffer through the volatile ready flag only after Anti-Xray finishes.
+            this.compactAntiXrayPalettes(this.antiXrayPaletteSections);
+        }
+        // Papyrus end - Compact Anti-Xray packet palettes
         this.ready = ready;
     }
     // Paper end - Async-Anti-Xray - Ready flag for the connection
