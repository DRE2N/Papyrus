+    public static final class NavigationSection {
+        private static final PathType[] PATH_TYPES = PathType.values();
+        private final long key;
+        private final long revision;
+        private final PalettedContainer<BlockState> states;
+        private final byte[] pathTypes;
+        private final boolean hasOnlyAir;
+
+        private NavigationSection(
+            final long key,
+            final long revision,
+            final PalettedContainer<BlockState> states,
+            final byte[] pathTypes,
+            final boolean hasOnlyAir
+        ) {
+            this.key = key;
+            this.revision = revision;
+            this.states = states;
+            this.pathTypes = pathTypes;
+            this.hasOnlyAir = hasOnlyAir;
+        }
+
+        public static NavigationSection copyOf(final long key, final long revision, final LevelChunkSection source) {
+            PalettedContainer<BlockState> states = source.states.copy();
+            byte[] pathTypes = new byte[LevelChunkSection.SECTION_SIZE];
+            boolean hasOnlyAir = source.hasOnlyAir();
+            if (hasOnlyAir) {
+                Arrays.fill(pathTypes, (byte)PathType.OPEN.ordinal());
+            } else {
+                for (int index = 0; index < pathTypes.length; index++) {
+                    pathTypes[index] = (byte)WalkNodeEvaluator.getPathTypeFromState(states.get(index)).ordinal();
+                }
+            }
+            return new NavigationSection(key, revision, states, pathTypes, hasOnlyAir);
+        }
+
+        public long key() {
+            return this.key;
+        }
+
+        public long revision() {
+            return this.revision;
+        }
+
+        public boolean hasOnlyAir() {
+            return this.hasOnlyAir;
+        }
+
+        public BlockState getBlockState(final int x, final int y, final int z) {
+            return this.states.get(SectionPos.sectionRelative(x), SectionPos.sectionRelative(y), SectionPos.sectionRelative(z));
+        }
+
+        public PathType getPathType(final int x, final int y, final int z) {
+            int index = SectionPos.sectionRelative(y) << 8 | SectionPos.sectionRelative(z) << 4 | SectionPos.sectionRelative(x);
+            return PATH_TYPES[Byte.toUnsignedInt(this.pathTypes[index])];
+        }
     }
